# Copy to .env in the repository root (for docker compose) or export these variables.
# Generate every secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- required ---
OPENDLP_TOKEN=                 # shared agent token (>=32 bytes). Agents that self-enroll get their own token instead.
OPENDLP_ADMIN_TOKEN=           # full admin API access (>=32 bytes)
OPENDLP_DASHBOARD_PASSWORD=    # dashboard admin login (user "admin"); dashboard is disabled while empty

# --- recommended ---
OPENDLP_ENROLL_CODE=           # one-time code installers use to self-enroll (>=16 bytes). Rotate when it leaks.
# OPENDLP_SIGNING_KEY=/etc/opendlp/policy-signing.pem   # ECDSA P-256 key: python server/tools/gen_signing_key.py
# OPENDLP_VIEWER_TOKEN=        # read-only API token (dashboards, SIEM pull)
# OPENDLP_DASHBOARD_VIEWER_PASSWORD=   # read-only dashboard login (user "viewer")

# --- monthly PDF report ---
# OPENDLP_ORG_NAME=Example Ltd                    # shown on the report cover
# OPENDLP_REPORT_EMAIL=1                          # e-mail last month's report to OPENDLP_SMTP_TO on the 1st

# --- deploy page ---
# OPENDLP_PUBLIC_URL=https://dlp.example.com     # URL agents use; shown in the dashboard deploy commands
# OPENDLP_RELEASE_REPO=owner/OpenDLP             # GitHub repo the deploy commands download releases from

# --- cloud drive scanning (report-only, see docs/CLOUD-SCAN.md) ---
# OPENDLP_CLOUD_SCAN_HOURS=24
# OPENDLP_GOOGLE_SA_FILE=/etc/opendlp/google-sa.json
# OPENDLP_GOOGLE_ADMIN_EMAIL=admin@example.com
# OPENDLP_GOOGLE_DOMAIN=example.com
# OPENDLP_M365_TENANT_ID=
# OPENDLP_M365_CLIENT_ID=
# OPENDLP_M365_CLIENT_SECRET=

# --- notifications for high/critical alerts ---
# OPENDLP_WEBHOOK_URL=https://hooks.slack.com/services/...   # any JSON webhook: Slack, Discord, Teams, Mattermost, n8n…
# OPENDLP_NOTIFY_MIN_SEVERITY=high     # low | medium | high | critical
# OPENDLP_NOTIFY_COOLDOWN_SECONDS=300  # same agent + event type is reported at most once per window
# OPENDLP_SMTP_HOST=smtp.example.com
# OPENDLP_SMTP_PORT=587
# OPENDLP_SMTP_USER=
# OPENDLP_SMTP_PASSWORD=
# OPENDLP_SMTP_FROM=opendlp@example.com
# OPENDLP_SMTP_TO=security@example.com,owner@example.com
# OPENDLP_SMTP_STARTTLS=1

# --- optional ---
# OPENDLP_DASHBOARD_USER=admin
# OPENDLP_DASHBOARD_VIEWER_USER=viewer
# OPENDLP_AGENT_TOKENS=/etc/opendlp/agent-tokens.json   # static per-agent tokens {"agent-id": "token"}
# OPENDLP_RETENTION_DAYS=90
# OPENDLP_OFFLINE_AFTER_SECONDS=300
# OPENDLP_POLICY=../policies/default-policy.json
# OPENDLP_POLICY_VERSION=      # unset = policy file mtime (auto-bumps on edit)
# OPENDLP_MAX_BODY_BYTES=2097152
# OPENDLP_DOMAIN=dlp.example.com   # for: docker compose --profile https up -d
