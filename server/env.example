# Copy to .env in the repository root (for docker compose) or export these variables.
# Generate every secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- required ---
LEAKWARDEN_TOKEN=                 # shared agent token (>=32 bytes). Agents that self-enroll get their own token instead.
LEAKWARDEN_ADMIN_TOKEN=           # full admin API access (>=32 bytes)
LEAKWARDEN_DASHBOARD_PASSWORD=    # dashboard admin login (user "admin"); dashboard is disabled while empty

# --- recommended ---
LEAKWARDEN_ENROLL_CODE=           # one-time code installers use to self-enroll (>=16 bytes). Rotate when it leaks.
# LEAKWARDEN_SIGNING_KEY=/etc/leakwarden/policy-signing.pem   # ECDSA P-256 key: python server/tools/gen_signing_key.py
# LEAKWARDEN_VIEWER_TOKEN=        # read-only API token (dashboards, SIEM pull)
# LEAKWARDEN_DASHBOARD_VIEWER_PASSWORD=   # read-only dashboard login (user "viewer")

# --- monthly PDF report ---
# LEAKWARDEN_ORG_NAME=Example Ltd                    # shown on the report cover
# LEAKWARDEN_REPORT_EMAIL=1                          # e-mail last month's report to LEAKWARDEN_SMTP_TO on the 1st

# --- deploy page ---
# LEAKWARDEN_PUBLIC_URL=https://dlp.example.com     # URL agents use; shown in the dashboard deploy commands
# LEAKWARDEN_RELEASE_REPO=owner/Leakwarden             # GitHub repo the deploy commands download releases from

# --- cloud drive scanning (report-only, see docs/CLOUD-SCAN.md) ---
# LEAKWARDEN_CLOUD_SCAN_HOURS=24
# LEAKWARDEN_GOOGLE_SA_FILE=/etc/leakwarden/google-sa.json
# LEAKWARDEN_GOOGLE_ADMIN_EMAIL=admin@example.com
# LEAKWARDEN_GOOGLE_DOMAIN=example.com
# LEAKWARDEN_M365_TENANT_ID=
# LEAKWARDEN_M365_CLIENT_ID=
# LEAKWARDEN_M365_CLIENT_SECRET=

# --- outbound e-mail scanning (report-only; needs Mail.Read / gmail.readonly, see docs/EMAIL-SCAN.md) ---
# LEAKWARDEN_EMAIL_SCAN=1
# LEAKWARDEN_EMAIL_INTERNAL_DOMAINS=example.com,example.co.uk

# --- tamper-evident audit log (recommended) ---
# Generate once and keep it OUTSIDE the database (secrets manager / env). Changing it later breaks verification.
# python -c "import secrets; print(secrets.token_hex(32))"
# LEAKWARDEN_AUDIT_KEY=

# --- SIEM forwarding (Splunk, Sentinel, QRadar, Wazuh, Graylog, Elastic) ---
# LEAKWARDEN_SYSLOG=tls://siem.example.com:6514   # udp://host:514 | tcp://host:514 | tls://host:6514
# LEAKWARDEN_SYSLOG_FORMAT=cef                    # cef | json

# --- dashboard single sign-on (OpenID Connect) ---
# Redirect URI to register at the provider: <LEAKWARDEN_PUBLIC_URL>/auth/callback
# LEAKWARDEN_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0   # Google: https://accounts.google.com
# LEAKWARDEN_OIDC_CLIENT_ID=
# LEAKWARDEN_OIDC_CLIENT_SECRET=
# LEAKWARDEN_OIDC_ADMINS=it@example.com,owner@example.com
# LEAKWARDEN_OIDC_VIEWERS=@example.com           # whole domain read-only; unlisted users are refused
# LEAKWARDEN_SESSION_SECRET=                     # set so sign-ins survive restarts
# LEAKWARDEN_SESSION_HOURS=8

# --- notifications for high/critical alerts ---
# LEAKWARDEN_WEBHOOK_URL=https://hooks.slack.com/services/...   # any JSON webhook: Slack, Discord, Teams, Mattermost, n8n…
# LEAKWARDEN_NOTIFY_MIN_SEVERITY=high     # low | medium | high | critical
# LEAKWARDEN_NOTIFY_COOLDOWN_SECONDS=300  # same agent + event type is reported at most once per window
# LEAKWARDEN_SMTP_HOST=smtp.example.com
# LEAKWARDEN_SMTP_PORT=587
# LEAKWARDEN_SMTP_USER=
# LEAKWARDEN_SMTP_PASSWORD=
# LEAKWARDEN_SMTP_FROM=leakwarden@example.com
# LEAKWARDEN_SMTP_TO=security@example.com,owner@example.com
# LEAKWARDEN_SMTP_STARTTLS=1

# --- optional ---
# LEAKWARDEN_DASHBOARD_USER=admin
# LEAKWARDEN_DASHBOARD_VIEWER_USER=viewer
# LEAKWARDEN_AGENT_TOKENS=/etc/leakwarden/agent-tokens.json   # static per-agent tokens {"agent-id": "token"}
# LEAKWARDEN_RETENTION_DAYS=90
# LEAKWARDEN_OFFLINE_AFTER_SECONDS=300
# LEAKWARDEN_POLICY=../policies/default-policy.json
# LEAKWARDEN_POLICY_VERSION=      # unset = policy file mtime (auto-bumps on edit)
# LEAKWARDEN_MAX_BODY_BYTES=2097152
# LEAKWARDEN_DOMAIN=dlp.example.com   # for: docker compose --profile https up -d
