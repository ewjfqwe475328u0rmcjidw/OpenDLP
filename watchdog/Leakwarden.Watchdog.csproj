<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Leakwarden.Watchdog</AssemblyName>
    <RootNamespace>Leakwarden.Watchdog</RootNamespace>
    <Version>0.15.0</Version>
    <Authors>Leakwarden Contributors</Authors>
    <Description>Leakwarden watchdog process for agent keep-alive</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

</Project>
