{
  "_comment": "Shared test vectors. The same cases run against the C# agent (agent.tests), the browser extension (browser-extension/test) and the server's Python detectors (server/tests). Keep them in sync by editing only this file.",
  "luhn": [["4111 1111 1111 1111", true], ["5500-0000-0000-0004", true], ["4111 1111 1111 1112", false], ["1234 5678 9012 3456", false]],
  "tw_national_id": [["A123456789", true], ["A123456788", false], ["Z999999999", false], ["A12345678", false]],
  "iban": [["GB82 WEST 1234 5698 7654 32", true], ["DE89 3704 0044 0532 0130 00", true], ["GB82 WEST 1234 5698 7654 33", false]],
  "scan": [
    {"name": "national id with checksum", "text": "客戶身分證 A123456789，另一個無效 A123456788",
     "rules": [{"id": "NID", "type": "builtin", "detector": "tw_national_id"}], "expect": {"NID": 1}},
    {"name": "card without context counts by default", "text": "order 4111 1111 1111 1111",
     "rules": [{"id": "CC", "type": "builtin", "detector": "credit_card"}], "expect": {"CC": 1}},
    {"name": "card requireContext drops bare number", "text": "order 4111 1111 1111 1111",
     "rules": [{"id": "CC", "type": "builtin", "detector": "credit_card", "requireContext": true}], "expect": {}},
    {"name": "card requireContext keeps labelled number", "text": "Card number: 4111 1111 1111 1111",
     "rules": [{"id": "CC", "type": "builtin", "detector": "credit_card", "requireContext": true}], "expect": {"CC": 1}},
    {"name": "ssn with context", "text": "Employee SSN 123-45-6789; invalid 000-12-3456 and 666-12-3456",
     "rules": [{"id": "SSN", "type": "builtin", "detector": "us_ssn", "requireContext": true}], "expect": {"SSN": 1}},
    {"name": "ssn-like ticket number ignored with requireContext", "text": "ticket ref 123-45-6789",
     "rules": [{"id": "SSN", "type": "builtin", "detector": "us_ssn", "requireContext": true}], "expect": {}},
    {"name": "custom context words", "text": "Kontonummer 123-45-6789",
     "rules": [{"id": "SSN", "type": "builtin", "detector": "us_ssn", "requireContext": true, "contextWords": ["kontonummer"]}], "expect": {"SSN": 1}},
    {"name": "documented example key excluded", "text": "aws_access_key_id = AKIAIOSFODNN7EXAMPLE",
     "rules": [{"id": "KEY", "type": "builtin", "detector": "api_key", "exclude": ["(?i)example"]}], "expect": {}},
    {"name": "real-looking key detected", "text": "aws_access_key_id = AKIAZ7QW3RT5YU8IOP2L",
     "rules": [{"id": "KEY", "type": "builtin", "detector": "api_key", "exclude": ["(?i)example"]}], "expect": {"KEY": 1}},
    {"name": "github token", "text": "token: ghp_aBcDeFgHiJkLmNoPqRsTuVwXyZ0123456789",
     "rules": [{"id": "KEY", "type": "builtin", "detector": "api_key"}], "expect": {"KEY": 1}},
    {"name": "private key header", "text": "-----BEGIN RSA PRIVATE KEY-----\nMIIE",
     "rules": [{"id": "PK", "type": "builtin", "detector": "private_key"}], "expect": {"PK": 1}},
    {"name": "iban with mod-97", "text": "Pay to GB82 WEST 1234 5698 7654 32 today, not GB82 WEST 1234 5698 7654 33",
     "rules": [{"id": "IBAN", "type": "builtin", "detector": "iban"}], "expect": {"IBAN": 1}},
    {"name": "multilingual passport", "text": "Reisepass Nr. C01X00T47. 여권 M12345678. passport expires 2027",
     "rules": [{"id": "PP", "type": "builtin", "detector": "passport"}], "expect": {"PP": 2}},
    {"name": "taiwan passport needs context", "text": "order 312345678 / 護照號碼: 312345678",
     "rules": [{"id": "TWP", "type": "builtin", "detector": "tw_passport"}], "expect": {"TWP": 1}},
    {"name": "keywords are case-insensitive and multilingual", "text": "This is CONFIDENTIAL. 本文件為機密。",
     "rules": [{"id": "KW", "type": "keywords", "keywords": ["confidential", "機密"]}], "expect": {"KW": 2}},
    {"name": "minMatches threshold", "text": "0912-345-678 0922333444",
     "rules": [{"id": "MOB", "type": "builtin", "detector": "tw_mobile", "minMatches": 3}], "expect": {}},
    {"name": "custom regex", "text": "ticket PRJ-1234 and PRJ-9999",
     "rules": [{"id": "PRJ", "type": "regex", "pattern": "PRJ-\\d{4}"}], "expect": {"PRJ": 2}}
  ]
}
